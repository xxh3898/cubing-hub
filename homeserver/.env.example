# Production images use one immutable full commit SHA.
API_IMAGE=ghcr.io/xxh3898/cubing-hub-api:0000000000000000000000000000000000000000
WEB_IMAGE=ghcr.io/xxh3898/cubing-hub-web:0000000000000000000000000000000000000000

# Keep runtime data outside a repository checkout.
POST_IMAGES_HOST_DIR=/Users/homeserver/Server/data/cubing-hub/post-images

# Replace every secret in the Mac mini runtime env file.
DB_NAME=cubing_hub
DB_USERNAME=cubing_hub
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
JWT_SECRET=change-me
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=https://cubing-hub.com,https://www.cubing-hub.com

POST_IMAGES_KEY_PREFIX=community/posts
POST_IMAGES_PUBLIC_BASE_URL=https://api.cubing-hub.com/uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM_ADDRESS=

FEEDBACK_DISCORD_WEBHOOK_URL=
RANKING_REDIS_REBUILD_MODE=disabled
